# Copy this file to config/.env and edit it. The app also reads a
# project-root .env if that file exists. Variables already set in the
# shell take precedence, and config/.env wins over the root file.
#
# Relative paths are resolved from the project root (the folder that
# contains app.py), so the working directory does not matter. Absolute
# paths work on Windows, macOS, and Linux. Use forward slashes even on
# Windows (C:/Users/you/model.safetensors).

# Hugging Face repo to serve. The default is a 2.5M-parameter ImageNet
# MobileNetV3, about 10 MB, and runs on CPU.
MODEL_ID=timm/mobilenetv3_small_100.lamb_in1k

# Commit to download. Leave empty to resolve the repo's current default
# commit at install time and pin whatever SHA is printed.
MODEL_REVISION=76b303ec28c466e9df37f4745dfb7aef20ab87ae

# image-classification, text-generation, or text-classification.
MODEL_TASK=image-classification

# timm, transformers, or auto.
# auto uses timm for image-classification repos under timm/, and
# transformers otherwise.
MODEL_BACKEND=timm

# auto picks cuda, then mps, then cpu. cpu is the low-memory default path
# when no GPU is present.
DEVICE=auto

# float32, float16, or bfloat16. On CPU, float16 and bfloat16 stay float32
# unless ALLOW_CPU_HALF=1.
TORCH_DTYPE=float32
ALLOW_CPU_HALF=0

# Stream transformers weights into the model instead of holding a full
# second copy during load.
LOW_CPU_MEM_USAGE=1

# 1 loads on the first request. 0 loads before the server starts.
LAZY_LOAD=1

TOP_K=5
MAX_NEW_TOKENS=40
MAX_INPUT_CHARS=4000
MAX_UPLOAD_MB=8

# Optional cap for CPU thread pools on a small laptop.
# TORCH_NUM_THREADS=2

HOST=127.0.0.1
PORT=5000

# WEIGHTS_DIR=weights

# Checkpoint override. A file, a snapshot directory, or a folder that
# contains the Hugging Face snapshot tree. When this is set, a missing
# file is an error and nothing is downloaded.
# MODEL_WEIGHTS=weights/model.safetensors

# Optional JSON list, index-to-name map, or woodsapp-style
# {"label_map": {"0": {"name": "...", "description": "..."}}}.
# ImageNet-1k names are used automatically for a 1000-way timm head.
# LABEL_MAP_PATH=config/labels.json

# Searched when MODEL_WEIGHTS is unset and weights/ has no snapshot yet.
# HF_HOME=
# HUGGINGFACE_HUB_CACHE=

# Only needed for a gated or private repo.
# HF_TOKEN=

# --- Other small presets -------------------------------------------------
# Uncomment one block and comment out the MODEL_* lines above.
#
# Image classification through transformers, about 14 MB:
# MODEL_ID=google/mobilenet_v2_1.0_224
# MODEL_REVISION=75e607b00aeae1297cc89d026a118bce012f5c5a
# MODEL_TASK=image-classification
# MODEL_BACKEND=transformers
#
# Text generation, TinyStories 1M (simple English, a few MB):
# MODEL_ID=roneneldan/TinyStories-1M
# MODEL_REVISION=77f1b168e219585646439073245fe87e56b3023e
# MODEL_TASK=text-generation
# MODEL_BACKEND=transformers
#
# Text classification, a 4.4M-parameter BERT (about 17 MB) fine-tuned for
# positive / negative sentiment. For a stronger SST-2 model, use
# distilbert/distilbert-base-uncased-finetuned-sst-2-english
# revision 714eb0fa89d2f80546fda750413ed43d93601a13 (about 260 MB).
# MODEL_ID=Facececersek/bedrock-sentiment-tiny
# MODEL_REVISION=16175109a6e476cee0c388d2aac37429ecf964dd
# MODEL_TASK=text-classification
# MODEL_BACKEND=transformers
#
# Larger vision model, same family as woodsapp (about 1.2 GB). On a 4 GB
# machine, leave LAZY_LOAD=1 and expect the process to use swap.
# Point LABEL_MAP_PATH at a 10,000-class map if you have one.
# MODEL_ID=timm/vit_large_patch14_clip_336.laion2b_ft_augreg_inat21
# MODEL_REVISION=72a53b6ad40843f079d85b2ee315f5fb222e2f0f
# MODEL_TASK=image-classification
# MODEL_BACKEND=timm
